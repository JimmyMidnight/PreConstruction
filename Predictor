  if(!withDetail.length){ panel.style.display='none'; return; }
  panel.style.display='block';
  var html = '<table class="data-table"><thead><tr><th>Project</th><th class="num">Building Efficiency</th><th class="num">Parking Spaces</th><th class="num">Parking Ratio</th><th class="num">Site Acres</th><th class="num">Density (units/acre)</th></tr></thead><tbody>';
  withDetail.forEach(function(p){
    html += '<tr><td>'+p.project+(p._boosted?' <span class="tags" style="color:var(--amber);">(BOOSTED)</span>':'')+'</td>'+
      '<td class="num">'+(p.buildingEfficiency?fmtPercent1(p.buildingEfficiency):'—')+'</td>'+
      '<td class="num">'+(p.parkingSpaces||'—')+'</td>'+
      '<td class="num">'+(p.parkingRatio||'—')+'</td>'+
      '<td class="num">'+(p.siteAcres||'—')+'</td>'+
      '<td class="num">'+(p.density||'—')+'</td></tr>';
  });
  html += '</tbody></table>';
  document.getElementById('projectDetailWrap').innerHTML = html;
}
function runBuild(){
  var market=document.getElementById('fMarket').value;
  var selectedTypes = getSelectedProductTypes();
  var selectedStruct = document.getElementById('fStructural').value;
  var unitsInput = parseFloat(document.getElementById('fUnits').value);
  var gsfInput = parseFloat(document.getElementById('fGSF').value);
  var useInflation = document.getElementById('fInflation').checked;
  var useRecency = document.getElementById('fRecency').checked;
  var boosts = getMarketBoosts();
  var matched=HISTORICAL_DATA.projects.filter(function(p){
    return (!market||p.market===market) && projectMatchesTypes(p, selectedTypes) && projectMatchesStructural(p, selectedStruct);
  });
  var chipsHtml = matched.map(function(p){
    var cls = p.costPerUnit ? '' : ' excluded';
    return '<span class="chip'+cls+'">'+p.project+(p.costPerUnit?'':' (no total)')+
      '<span class="detail">'+p.productTypeDetail+' &middot; '+p.costBasisYear+'</span>'+
      '<span class="tags">'+p.productTypes.join(' + ')+'</span>'+
      '<span class="struct">'+p.structuralSystem+'</span></span>';
  }).join('');
  /* BUG FIX: use the deduplicated boosted-project list so each boosted project renders exactly one chip */
  getUniqueBoostedProjects(boosts).forEach(function(entry){
    var p = entry.project, b = entry.boost;
    chipsHtml += '<span class="chip boosted">'+p.project+' <span class="tags" style="color:var(--amber);">BOOSTED &times;'+b.factor.toFixed(2)+'</span><span class="struct">'+p.structuralSystem+'</span></span>';
  });
  document.getElementById('matchedProjectsChips').innerHTML = (matched.length||boosts.length) ? '<strong style="font-size:12px;color:var(--gray);margin-right:4px;">Matched:</strong>'+chipsHtml : '';
  var bvRows=HISTORICAL_DATA.budgetVarianceRows.filter(function(r){
    var proj = HISTORICAL_DATA.projects.find(function(p){return p.project===r.project;});
    return (!market||r.market===market) && r.productTypes.some(function(t){ return !selectedTypes.length || selectedTypes.indexOf(t)!==-1; })
      && (!selectedStruct || (proj && proj.structuralSystem===selectedStruct));
  });
  var coRows=HISTORICAL_DATA.coGrowthRows.filter(function(r){
    var proj = HISTORICAL_DATA.projects.find(function(p){return p.project===r.project;});
    return (!market||r.market===market) && r.productTypes.some(function(t){ return !selectedTypes.length || selectedTypes.indexOf(t)!==-1; })
      && (!selectedStruct || (proj && proj.structuralSystem===selectedStruct));
  });
  var bvAgg=aggregate(bvRows,'variancePct', useRecency); var coAgg=aggregate(coRows,'growthPct', useRecency);
  var rp=document.getElementById('resultsPanel'), cp=document.getElementById('coResultsPanel'), np=document.getElementById('noDataPanel');
  if(!matched.length && !boosts.length){
    rp.style.display='none'; cp.style.display='none';
    document.getElementById('predictPanel').style.display='none';
    document.getElementById('projectDetailPanel').style.display='none';
    np.style.display='block'; return;
  }
  np.style.display='none';
  renderPredictionAndCrossCheck(matched, unitsInput, gsfInput, useInflation, useRecency, boosts);
  renderProjectDetail(matched, boosts);
  if(bvAgg.length){ rp.style.display='block'; document.getElementById('varianceTableWrap').innerHTML=renderTable(bvAgg); } else rp.style.display='none';
  if(coAgg.length){ cp.style.display='block'; document.getElementById('coTableWrap').innerHTML=renderTable(coAgg); } else cp.style.display='none';
}
function renderAllProjects(){
  var html='<table class="data-table"><thead><tr><th>Project</th><th>Market</th><th>Product Types</th><th>Structural System</th><th class="num">$/Unit (2026$)</th><th class="num">$/GSF (2026$)</th><th class="num">Bldg Eff.</th><th class="num">Parking Ratio</th><th class="num">Acres</th></tr></thead><tbody>';
  HISTORICAL_DATA.projects.forEach(function(p){
    html+='<tr><td>'+p.project+'</td><td>'+p.market+'</td><td>'+p.productTypes.join(', ')+'</td><td style="font-size:11px;">'+p.structuralSystem+'</td>'+
      '<td class="num">'+fmtMoney(p.costPerUnitAdjusted)+'</td>'+
      '<td class="num">$'+p.costPerGSFAdjusted.toFixed(2)+'</td>'+
      '<td class="num">'+fmtPercent1(p.buildingEfficiency)+'</td>'+
      '<td class="num">'+p.parkingRatio+'</td>'+
      '<td class="num">'+p.siteAcres+'</td></tr>';
  });
  html+='</tbody></table>'; document.getElementById('allProjectsWrap').innerHTML=html;
}
function renderRecencyTable(){
  var html = '<table class="data-table"><thead><tr><th>Cost Basis Year</th><th class="num">Age (years)</th><th class="num">Weight</th></tr></thead><tbody>';
  for(var y=2018; y<=2026; y++){
    var age = HISTORICAL_DATA.currentYear - y;
    var w = Math.pow(HISTORICAL_DATA.decayFactor, age);
    html += '<tr><td>'+y+'</td><td class="num">'+age+'</td><td class="num">'+w.toFixed(4)+'</td></tr>';
  }
  html += '</tbody></table>';
  document.getElementById('recencyTableWrap').innerHTML = html;
}
function renderCostIndexTable(){
  var idx = HISTORICAL_DATA.costIndex;
  var years = Object.keys(idx).sort();
  var html = '<table class="data-table"><thead><tr><th>Year</th><th class="num">Index Value</th><th>Source</th></tr></thead><tbody>';
  years.forEach(function(y){
    var row = idx[y];
    var isBase = (parseInt(y) === HISTORICAL_DATA.baseYear);
    html += '<tr'+(isBase?' style="font-weight:700;background:#E8F0E4;"':'')+'><td>'+y+(isBase?' (base year)':'')+'</td><td class="num">'+row.value.toFixed(1)+'</td><td style="font-size:12px;">'+row.source+'</td></tr>';
  });
  html += '</tbody></table>';
  document.getElementById('costIndexTableWrap').innerHTML = html;
}
function renderMarketFactorsTable(){
  var html = '<table class="data-table"><thead><tr><th>Product Type</th><th>Market A</th><th>Market B</th><th class="num">Factor (A/B)</th><th class="num">A avg $/GSF</th><th class="num">B avg $/GSF</th><th class="num">Projects (A, B)</th><th>Status</th></tr></thead><tbody>';
  var seen = {};
  HISTORICAL_DATA.marketFactors.forEach(function(mf){
    var key = mf.productType+'|'+[mf.marketA,mf.marketB].sort().join('|');
    if(seen[key]) return;
    seen[key] = true;
    var statusBadge = mf.confident ? '<span class="badge high">Confident</span>' : '<span class="badge low">Reference only</span>';
    html += '<tr><td>'+mf.productType+'</td><td>'+mf.marketA+'</td><td>'+mf.marketB+'</td>'+
      '<td class="num">'+mf.factorAoverB.toFixed(3)+'</td>'+
      '<td class="num">$'+mf.avgA.toFixed(2)+'</td><td class="num">$'+mf.avgB.toFixed(2)+'</td>'+
      '<td class="num">'+mf.nA+', '+mf.nB+'</td><td>'+statusBadge+'</td></tr>';
  });
  html += '</tbody></table>';
  document.getElementById('marketFactorsWrap').innerHTML = html;
}
document.querySelectorAll('.tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active');});
    document.querySelectorAll('.sheet').forEach(function(s){s.classList.remove('active');});
    tab.classList.add('active'); document.querySelector('.sheet[data-sheet="'+tab.getAttribute('data-sheet')+'"]').classList.add('active');
    if(tab.getAttribute('data-sheet')==='alldata') renderAllProjects();
    if(tab.getAttribute('data-sheet')==='methodology'){ renderRecencyTable(); renderCostIndexTable(); }
    if(tab.getAttribute('data-sheet')==='marketfactors') renderMarketFactorsTable();
  });
});
document.getElementById('buildBtn').addEventListener('click', runBuild);
populateFilters(); renderAllProjects();
</script>
</body>
</html>
