function getUniqueBoostedProjects(boosts){
  var boostedMap = {}; // project name -> {project, boost}
  (boosts||[]).forEach(function(b){
    HISTORICAL_DATA.projects.forEach(function(p){
      if(p.market===b.market && p.productTypes.indexOf(b.type)!==-1 && p.verifiedTotalCost){
        if(!boostedMap[p.project]){ boostedMap[p.project] = {project:p, boost:b}; }
      }
    });
  });
  return Object.keys(boostedMap).map(function(k){ return boostedMap[k]; });
}

function computeUnitsStats(matchedProjects, useInflation, useRecency, boosts){
  var withCost = matchedProjects.filter(function(p){ return p.verifiedTotalCost && p.units && p.costPerUnit; });
  var vals = [], weights = [], srcProjects = [];
  withCost.forEach(function(p){
    vals.push((useInflation && p.costPerUnitAdjusted) ? p.costPerUnitAdjusted : p.costPerUnit);
    weights.push((useRecency && p.recencyWeight) ? p.recencyWeight : 1);
    srcProjects.push(p);
  });
  getUniqueBoostedProjects(boosts).forEach(function(entry){
    var p = entry.project, b = entry.boost;
    if(!p.costPerUnit) return;
    var baseVal = (useInflation && p.costPerUnitAdjusted) ? p.costPerUnitAdjusted : p.costPerUnit;
    var adjVal = baseVal / b.factor;
    vals.push(adjVal);
    weights.push((useRecency && p.recencyWeight) ? p.recencyWeight : 1);
    srcProjects.push(Object.assign({}, p, {_boosted:true, _boostFactor:b.factor, _boostedVal:adjVal}));
  });
  if(!vals.length) return null;
  var avg = useRecency ? weightedAvg(vals, weights) : weightedAvg(vals, null);
  return { avg:avg, median:median(vals), min:Math.min.apply(null,vals), max:Math.max.apply(null,vals), n:vals.length, projects:srcProjects };
}
