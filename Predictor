function fmtPct(v){ if(v===null||v===undefined||isNaN(v)) return '—'; var pct=(v*100); var cls=pct>=0?'pct-pos':'pct-neg'; var sign=pct>=0?'+':''; return '<span class="'+cls+'">'+sign+pct.toFixed(1)+'%</span>'; }
function fmtMoney(v){ if(v===null||v===undefined||isNaN(v)) return '—'; return '$'+Math.round(v).toLocaleString(); }
function confidenceBadge(n){ if(n>=5) return '<span class="badge high">Reliable</span>'; if(n>=2) return '<span class="badge med">Limited data</span>'; return '<span class="badge low">Insufficient data</span>'; }
function median(arr){ if(!arr.length) return null; var s=arr.slice().sort(function(a,b){return a-b;}); var mid=Math.floor(s.length/2); return s.length%2?s[mid]:(s[mid-1]+s[mid])/2; }
function weightedAvg(vals, weights){
  if(!weights){ return vals.reduce(function(a,b){return a+b;},0)/vals.length; }
  var sumW = weights.reduce(function(a,b){return a+b;},0);
  if(sumW === 0) return vals.reduce(function(a,b){return a+b;},0)/vals.length;
  var sum = 0; for(var i=0;i<vals.length;i++){ sum += vals[i]*weights[i]; }
  return sum/sumW;
}
function aggregate(rows, valueKey, useRecency){
  var byTrade={};
  rows.forEach(function(r){
    if(r.flag==='Excluded — not representative') return;
    var t=r.trade; if(!byTrade[t]) byTrade[t]={vals:[],weights:[]};
    var v=r[valueKey];
    if(v!==null && v!==undefined && !isNaN(v)){
      byTrade[t].vals.push(v);
      byTrade[t].weights.push(useRecency && r.recencyWeight ? r.recencyWeight : 1);
    }
  });
  var out=[];
  Object.keys(byTrade).forEach(function(t){
    var vals=byTrade[t].vals, weights=byTrade[t].weights;
    var avg = useRecency ? weightedAvg(vals, weights) : weightedAvg(vals, null);
    out.push({trade:t,n:vals.length,avg:avg,median:median(vals),min:Math.min.apply(null,vals),max:Math.max.apply(null,vals)});
  });
  out.sort(divisionSort);
